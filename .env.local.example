# ============================================================
# GB Store — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in the values
# cp .env.local.example .env.local
# ============================================================

# --- Supabase (Public — safe to expose, protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (Server-only — NEVER expose to client) ---
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Cloudflare R2 (Image CDN — public read URL) ---
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- WhatsApp (Checkout) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=972595809023

# --- White-Label / Multi-Instance Branding ---
NEXT_PUBLIC_STORE_NAME="Eloria FASHION"
NEXT_PUBLIC_STORE_LOGO="/logo.png"
NEXT_PUBLIC_STORE_DESC="متجر الموضة والأناقة الفاخرة. شنط ماستر كوالتي، عطور وساعات وماركات عالمية بأسعار مميزة مع خدمة التوصيل السريع لجميع مناطق فلسطين."
NEXT_PUBLIC_STORE_ID="eloria"

# --- White-Label Theme & Color Customization (.env overrides CSS :root) ---
NEXT_PUBLIC_THEME_ACCENT_COLOR="#C59850"
NEXT_PUBLIC_THEME_ACCENT_HOVER="#AD823E"
NEXT_PUBLIC_THEME_ACCENT_SOFT="rgba(197, 152, 80, 0.15)"
NEXT_PUBLIC_THEME_BG_PRIMARY="#FDFBF7"
NEXT_PUBLIC_THEME_BG_SECONDARY="#F5F2EC"
NEXT_PUBLIC_THEME_TEXT_PRIMARY="#111111"

# --- Multi-Supplier Architecture ---
NEXT_PUBLIC_SUPPORTED_SUPPLIERS="gbstore,balagan,sakher"
NEXT_PUBLIC_SUPPLIER_NAMES='{"gbstore": "جي بي ستور - الأزياء", "balagan": "بلاجان - الأحذية", "sakher": "ساخر - الأزياء الرياضية"}'

# ============================================================
# Scraper-Only Variables (used by Python scraper, not Next.js)
# Set these as GitHub Actions secrets for CI/CD.
# For local testing, export them in your terminal or create
# a scraper/.env file.
# ============================================================

# --- Supplier Credentials ---
# SUPPLIER_PHONE=your-phone-number
# SUPPLIER_PASSWORD=your-password
# BALAGAN_PHONE=your-phone-number
# BALAGAN_PASSWORD=your-password
# SAKHER_PHONE=your-phone-number
# SAKHER_PASSWORD=your-password

# --- Supabase (same values as above, different env var names for scraper) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Cloudflare R2 (S3-compatible API for uploads) ---
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_ACCESS_KEY=your-r2-access-key
# R2_SECRET_KEY=your-r2-secret-key
# R2_BUCKET=gb-store-images
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
